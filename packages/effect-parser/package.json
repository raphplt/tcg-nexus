{
  "name": "@repo/effect-parser",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "parse": "tsx src/cli.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "test:cov": "mkdir -p coverage && tsx --test --experimental-test-coverage --test-coverage-exclude='**/node_modules/**' --test-coverage-exclude='**/dist/**' --test-coverage-exclude='**/*.test.ts' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/**/*.test.ts",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.3.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "5.8.3",
    "vitest": "^3.1.0"
  }
}
