+  it("diagnoses the first migration failing on an empty database with synchronization disabled", async () => {
+    const options = {
+      type: "postgres" as const, host: process.env.DATABASE_HOST,
+      port: Number(process.env.DATABASE_PORT), username: process.env.DATABASE_USER,
+      password: process.env.DATABASE_PASSWORD, synchronize: false,
+    };
+    const admin = await new DataSource({ ...options, database: process.env.DATABASE_NAME }).initialize();
+    const fresh = new DataSource({ ...options, database: "tcg_audit_empty", migrations: MIGRATIONS });
+    try {
+      await admin.query('CREATE DATABASE tcg_audit_empty');
+      await fresh.initialize();
+      let failure: unknown;
+      try { await fresh.runMigrations(); } catch (error) { failure = error; }
+      expect(failure).toBeDefined();
+      console.log("AUDIT: fresh migration fails:", (failure as Error).message);
+    } finally {
+      if (fresh.isInitialized) await fresh.destroy();
+      await admin.query('DROP DATABASE IF EXISTS tcg_audit_empty');
+      await admin.destroy();
+    }
+  });
+});
