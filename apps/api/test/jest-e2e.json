{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1",
    "^@repo/pokemon-dataset$": "<rootDir>/../../../packages/pokemon-dataset/src/index.ts",
    "^@repo/scan-contract$": "<rootDir>/../../../packages/scan-contract/src/index.ts"
  },
  "setupFiles": ["<rootDir>/setup-e2e.ts"]
}
