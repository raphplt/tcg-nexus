{
  "name": "tcgdex",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "seed": "cd apps/api && npm run seed",
    "lint": "turbo lint",
    "format": "biome format --write .",
    "check-types": "turbo check-types",
    "test": "npm --prefix apps/api test -- --no-watchman && npm --prefix apps/web test && npm --prefix apps/fetch test && npm --prefix packages/effect-parser test && npm --prefix apps/mobile test && python3 -m unittest discover apps/vision",
    "test:all": "npm run test",
    "test:cov": "tsx scripts/run-all-coverage.ts",
    "test:e2e:tournament": "npm run test:e2e:tournament -w api",
    "bench:scan": "npm run bench:scan -w api",
    "scan:bench": "npm run bench:scan -w api"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.3",
    "npm-check-updates": "^18.0.2",
    "turbo": "^2.6.0",
    "typescript": "5.8.3",
    "webpack": "5.95.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.0",
  "overrides": {
    "webpack": "5.95.0",
    "nodemailer": "^9.0.5",
    "tar": "^7.5.21",
    "brace-expansion": "^2.1.4",
    "js-yaml": "^4.1.0"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "workspaces": [
    "apps/*",
    "packages/typescript-config",
    "packages/ui",
    "packages/effect-parser",
    "packages/scan-contract",
    "packages/pokemon-dataset"
  ]
}
